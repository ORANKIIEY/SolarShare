# Copy to .env.local (git-ignored) and fill in. Server-only settings:
# never rename any of these to NEXT_PUBLIC_*, which would ship them to browsers.

# Deployer TEST key (KYC officer, admin, operator on the Base Sepolia contracts).
# Used only by the /api/operator and /api/applicants routes. Testnet only.
OPERATOR_PRIVATE_KEY=

# Password for the operator page (/solar/operator). Pick a long random one.
OPERATOR_PASSWORD=

# 1 = approve new investors straight after the mocked ID check (demo).
# 0 = they wait in the operator page's list.
DEMO_AUTO_APPROVE=1

# Where the sponsor service runs (npm run sponsor in Blockchain/).
SPONSOR_URL=http://127.0.0.1:8787
