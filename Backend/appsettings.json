{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Backend.Services.TheftService": "Debug"
    }
  },
  "AllowedHosts": "*",

  // ── Huawei AOM / LTS (Application Operations Management / Log Tank Service) ──
  // Work Breakdown: "Set up monitoring with AOM and LTS"
  // In production, configure the Huawei ICAgent on the CCE node to ship these
  // structured logs to LTS automatically. AOM reads LTS for metric dashboards.
  // No SDK change required — standard Microsoft.Extensions.Logging is collected.

  "Mqtt": {
    // Local dev: Eclipse Mosquitto container
    // Production: Huawei IoTDA (Device Access) MQTT broker endpoint
    //   Host: iot-{project-id}.iot-mqtts.{region}.myhuaweicloud.com
    //   Port: 8883 (TLS) — device certs managed via IoTDA certificate service
    "Server": "localhost",
    "Port": 1883
  },

  "ConnectionStrings": {
    // Local dev: MySQL 8.0 container (TaurusDB-compatible binary protocol)
    // Production: Huawei Cloud TaurusDB (GaussDB for MySQL) connection string
    //   Format: Server={host};Port=3306;Database=gridguard;Uid={user};Pwd={dew-managed-secret};SslMode=Required;
    //   Enable dual-cluster HA in the TaurusDB console for RPO = 0.
    //   Enable DBSS (Database Security Service) for audit logging of all DML/DDL.
    "TaurusDB": ""
  },

  "HuaweiCloud": {
    "OBS": {
      // Work Breakdown: Evidence waveforms stored in OBS (Object Storage Service)
      // Bucket policy: private; server-side encryption via DEW KMS key
      "AccessKey": "",
      "SecretKey": "",
      "Endpoint": "obs.ap-southeast-3.myhuaweicloud.com",
      "BucketName": "gridguard-evidence-za",
      "Region": "ap-southeast-3"
    },
    "ModelArts": {
      // Work Breakdown: TensorFlow/PyTorch \u2192 MindSpore AI framework on ModelArts
      // Real-time inference endpoint created in ModelArts \u2192 Service Management
      "InferenceEndpoint": "",
      "ApiToken": ""
    }
  },

  "Frontend": {
    // Work Breakdown: Vercel/Netlify \u2192 CAE static hosting
    "BaseUrl": "http://localhost:3000"
  },

  "Authentication": {
    // Work Breakdown: Auth0 \u2192 IAM with MFA integration
    // Huawei IAM PKCE OAuth 2.0; MFA virtual device enabled in IAM console
    "Huawei": {
      "ClientId": "",
      "ClientSecret": "",
      "AuthorizationEndpoint": "https://oauth-login.cloud.huawei.com/oauth2/v3/authorize",
      "TokenEndpoint": "https://oauth-login.cloud.huawei.com/oauth2/v3/token",
      "UserInformationEndpoint": "https://account.cloud.huawei.com/rest.php?nsp_svc=GOpen.User.getInfo"
    }
  },

  // ── Huawei Security Services (configured in Cloud Console, not in app) ──────
  // WAF (Web Application Firewall):
  //   - Rate limiting: 1000 req/min per IP (replaces reCAPTCHA)
  //   - OWASP Top-10 rule set enabled
  //   - CC attack protection enabled
  // HSS (Host Security Service):
  //   - Installed on all CCE nodes via ICAgent
  //   - Vulnerability scan: daily
  //   - Intrusion detection: real-time
  // DEW (Data Encryption Workshop):
  //   - KMS key: gridguard-jwt-key (rotate every 90 days)
  //   - All OBS buckets server-side encrypted with DEW managed key
  // DBSS (Database Security Service):
  //   - Attached to TaurusDB instance
  //   - Full DML/DDL audit logging shipped to LTS
  // Anti-DDoS (AAD):
  //   - Attached to EIP of the CCE LoadBalancer
  //   - Tbit/s scrubbing capacity; 24/7 SOC
  "Jwt": {
    "Secret": "",
    "Issuer": "GridGuardAI"
  }
}
