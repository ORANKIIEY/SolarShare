# Copy this file to .env and fill it in. .env is git-ignored: never commit it.
# TESTNET ONLY. Never put a key that holds real money here.

# Private key of the deployer wallet (0x + 64 hex characters).
# `npm run wallet:new` creates a fresh one and writes it into .env for you.
DEPLOYER_PRIVATE_KEY=

# Base Sepolia RPC endpoint. The public one is fine for now.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Etherscan API key (etherscan.io > My Account > API Keys). With the
# Etherscan V2 API the same key verifies contracts on sepolia.basescan.org.
BASESCAN_API_KEY=

# --- Deploy settings (all optional; defaults shown) -------------------------
# The meter's signing address. Default: the Wokwi meter (Hardware/wokwi-meter).
# METER_DEVICE_ADDRESS=0xaa69C29dA92fa7d0Ef717705Cd21Dd6e4D641ff3
# Where share-sale USDC goes. Default: the deployer.
# TREASURY_ADDRESS=
# Seconds without a reading before the meter shows OFFLINE (short for the demo).
# OFFLINE_TIMEOUT_S=120
# Only if Circle's faucet runs dry: deploy a clearly labelled FAKE MockUSDC on
# Base Sepolia instead of using Circle's test USDC.
# USE_MOCK_USDC=false
