{
  "name": "solarshare-blockchain",
  "version": "1.0.0",
  "private": true,
  "description": "SolarShare smart contracts: community solar shares, signed meter readings and USDC payouts on Base Sepolia (Hardhat + viem)",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "clean": "hardhat clean",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "preflight:baseSepolia": "tsx scripts/preflight.ts",
    "deploy:baseSepolia": "hardhat run scripts/deploy.ts --network baseSepolia",
    "verify:baseSepolia": "hardhat run scripts/verify.ts --network baseSepolia",
    "wallet:new": "tsx scripts/new-wallet.ts",
    "wallet:address": "tsx scripts/show-address.ts",
    "verify-spike": "tsx scripts/verify-spike.ts",
    "relayer": "tsx relayer/src/main.ts",
    "relayer:demo": "tsx relayer/src/main.ts --replay",
    "relayer:typecheck": "tsc --noEmit -p relayer",
    "docs:build": "tsx scripts/build-asset-documents.ts",
    "docs:hash": "tsx scripts/hash-asset-documents.ts",
    "sponsor": "tsx relayer/src/sponsor/main.ts"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "mqtt": "5.16.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "0.15.16",
    "@nomicfoundation/hardhat-ignition-viem": "0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "1.1.2",
    "@nomicfoundation/hardhat-toolbox-viem": "4.1.2",
    "@nomicfoundation/hardhat-verify": "2.1.3",
    "@nomicfoundation/hardhat-viem": "2.1.5",
    "@nomicfoundation/ignition-core": "0.15.15",
    "@types/chai": "4.3.20",
    "@types/chai-as-promised": "7.1.8",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.5",
    "@types/pdfkit": "0.17.7",
    "chai": "4.5.0",
    "chai-as-promised": "7.1.2",
    "hardhat": "2.29.1",
    "hardhat-gas-reporter": "2.3.0",
    "pdfkit": "0.20.2",
    "solidity-coverage": "0.8.17",
    "ts-node": "10.9.2",
    "tsx": "4.23.14",
    "typescript": "5.9.3",
    "viem": "2.57.11"
  }
}
