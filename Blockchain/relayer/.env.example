# SolarShare relayer settings. Copy to relayer/.env (git-ignored) and fill in.
# Nothing here is needed for a local Hardhat run except DEMO_DEVICE_PRIVATE_KEY
# for the software meter.

# Which chain: localhost (Hardhat node, `npm run node`) or baseSepolia.
NETWORK=localhost

# JSON-RPC endpoint. Leave empty for the default
# (localhost: http://127.0.0.1:8545, baseSepolia: https://sepolia.base.org).
RPC_URL=

# The wallet that PAYS THE GAS for each reading. TESTNET-ONLY key, never a
# wallet with real money. It cannot fake readings: the oracle checks the meter's
# own signature. On localhost you can leave it empty: the node's first test
# account is used.
RELAYER_PRIVATE_KEY=

# MeterOracle address. Leave empty to read it from deployments/<NETWORK>.json
# (written by scripts/deploy.ts), or point DEPLOYMENTS_FILE at another file.
ORACLE_ADDRESS=
DEPLOYMENTS_FILE=

# Meter and MQTT. Primary broker first; the relayer listens on all of them at
# once, so if one is down readings still arrive through the other.
METER_ID=1
MQTT_BROKERS=mqtt://test.mosquitto.org:1883,mqtt://broker.hivemq.com:1883
# Default: solarshare/meter/<METER_ID>/reading
MQTT_TOPIC=

# Every received message is appended here (JSON lines, git-ignored).
RECORD_DIR=recordings

# --- Software meter (DEMO BACKUP, `npm run relayer -- --replay`) ---
# The meter device's TEST private key. Use the same key as the Wokwi meter
# (Hardware/wokwi-meter/secrets.h), so the oracle accepts it without changes.
# Or any test key plus --register-device (needs the admin wallet above).
DEMO_DEVICE_PRIVATE_KEY=
# Seconds between software-meter readings (the real meter: 30).
REPLAY_INTERVAL_S=6
